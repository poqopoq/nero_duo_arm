<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dual_nero_webapp</name>
  <version>0.1.0</version>
  <description>Browser dashboard for joint control, 3D pose display, and RealSense monitoring of two NERO arms.</description>
  <maintainer email="todo@example.com">robot</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>agx_arm_description</exec_depend>
  <exec_depend>dual_nero_cameras</exec_depend>
  <exec_depend>dual_nero_control</exec_depend>
  <exec_depend>dual_nero_description</exec_depend>
  <exec_depend>dual_nero_moveit_config</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-wsproto</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
