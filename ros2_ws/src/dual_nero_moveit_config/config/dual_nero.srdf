<?xml version="1.0" encoding="UTF-8"?>
<robot name="dual_nero_tabletop">
  <group name="left_arm">
    <chain base_link="left_base_link" tip_link="left_tcp_link"/>
  </group>

  <group name="right_arm">
    <chain base_link="right_base_link" tip_link="right_tcp_link"/>
  </group>

  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <group name="left_gripper">
    <joint name="left_ctag_left_1_joint"/>
  </group>

  <group name="right_gripper">
    <joint name="right_ctag_left_1_joint"/>
  </group>

  <group name="both_grippers">
    <group name="left_gripper"/>
    <group name="right_gripper"/>
  </group>

  <passive_joint name="left_ctag_left_support_joint"/>
  <passive_joint name="left_ctag_left_2_joint"/>
  <passive_joint name="left_ctag_right_2_joint"/>
  <passive_joint name="left_ctag_right_1_joint"/>
  <passive_joint name="left_ctag_right_support_joint"/>
  <passive_joint name="right_ctag_left_support_joint"/>
  <passive_joint name="right_ctag_left_2_joint"/>
  <passive_joint name="right_ctag_right_2_joint"/>
  <passive_joint name="right_ctag_right_1_joint"/>
  <passive_joint name="right_ctag_right_support_joint"/>

  <group_state group="left_arm" name="home">
    <joint name="left_joint1" value="0"/>
    <joint name="left_joint2" value="0"/>
    <joint name="left_joint3" value="0"/>
    <joint name="left_joint4" value="0"/>
    <joint name="left_joint5" value="0"/>
    <joint name="left_joint6" value="0"/>
    <joint name="left_joint7" value="0"/>
  </group_state>

  <group_state group="right_arm" name="home">
    <joint name="right_joint1" value="0"/>
    <joint name="right_joint2" value="0"/>
    <joint name="right_joint3" value="0"/>
    <joint name="right_joint4" value="0"/>
    <joint name="right_joint5" value="0"/>
    <joint name="right_joint6" value="0"/>
    <joint name="right_joint7" value="0"/>
  </group_state>



  <group_state group="left_arm" name="support">
    <joint name="left_joint1" value="-1.579034281"/>
    <joint name="left_joint2" value="-1.757145131"/>
    <joint name="left_joint3" value="-0.034435346"/>
    <joint name="left_joint4" value="2.115"/>
    <joint name="left_joint5" value="-0.029373891"/>
    <joint name="left_joint6" value="-0.003665191"/>
    <joint name="left_joint7" value="1.545"/>
  </group_state>

  <group_state group="right_arm" name="support">
    <joint name="right_joint1" value="1.666667263"/>
    <joint name="right_joint2" value="-0.246841916"/>
    <joint name="right_joint3" value="-0.438095096"/>
    <joint name="right_joint4" value="1.094618147"/>
    <joint name="right_joint5" value="-0.688130964"/>
    <joint name="right_joint6" value="0.528677684"/>
    <joint name="right_joint7" value="1.298612230"/>
  </group_state>

  <group_state group="both_arms" name="support">
    <joint name="left_joint1" value="-1.579034281"/>
    <joint name="left_joint2" value="-1.757145131"/>
    <joint name="left_joint3" value="-0.034435346"/>
    <joint name="left_joint4" value="2.115"/>
    <joint name="left_joint5" value="-0.029373891"/>
    <joint name="left_joint6" value="-0.003665191"/>
    <joint name="left_joint7" value="1.545"/>
    <joint name="right_joint1" value="1.666667263"/>
    <joint name="right_joint2" value="-0.246841916"/>
    <joint name="right_joint3" value="-0.438095096"/>
    <joint name="right_joint4" value="1.094618147"/>
    <joint name="right_joint5" value="-0.688130964"/>
    <joint name="right_joint6" value="0.528677684"/>
    <joint name="right_joint7" value="1.298612230"/>
  </group_state>

  <group_state group="left_gripper" name="open">
    <joint name="left_ctag_left_1_joint" value="0"/>
  </group_state>
  <group_state group="left_gripper" name="closed">
    <joint name="left_ctag_left_1_joint" value="-0.90017"/>
  </group_state>
  <group_state group="right_gripper" name="open">
    <joint name="right_ctag_left_1_joint" value="0"/>
  </group_state>
  <group_state group="right_gripper" name="closed">
    <joint name="right_ctag_left_1_joint" value="-0.90017"/>
  </group_state>
  <group_state group="both_grippers" name="open">
    <joint name="left_ctag_left_1_joint" value="0"/>
    <joint name="right_ctag_left_1_joint" value="0"/>
  </group_state>
  <group_state group="both_grippers" name="closed">
    <joint name="left_ctag_left_1_joint" value="-0.90017"/>
    <joint name="right_ctag_left_1_joint" value="-0.90017"/>
  </group_state>

  <!-- Adjacent-link collision exclusions for the left arm. -->
  <disable_collisions link1="left_base_link" link2="left_link1" reason="Adjacent"/>
  <disable_collisions link1="left_link1" link2="left_link2" reason="Adjacent"/>
  <disable_collisions link1="left_link2" link2="left_link3" reason="Adjacent"/>
  <disable_collisions link1="left_link3" link2="left_link4" reason="Adjacent"/>
  <disable_collisions link1="left_link4" link2="left_link5" reason="Adjacent"/>
  <disable_collisions link1="left_link5" link2="left_link6" reason="Adjacent"/>
  <disable_collisions link1="left_link6" link2="left_link7" reason="Adjacent"/>
  <disable_collisions link1="left_link7" link2="left_tool0" reason="Adjacent"/>
  <disable_collisions link1="left_tool0" link2="left_tcp_link" reason="Adjacent"/>
  <disable_collisions link1="left_link7" link2="left_ctag_ft_sensor_link" reason="Adjacent"/>
  <disable_collisions link1="left_tool0" link2="left_ctag_ft_sensor_link" reason="Adjacent"/>
  <disable_collisions link1="left_ctag_ft_sensor_link" link2="left_ctag_connector_link" reason="Adjacent"/>
  <disable_collisions link1="left_ctag_connector_link" link2="left_ctag_base_link" reason="Adjacent"/>
  <disable_collisions link1="left_tool0" link2="left_ctag_connector_link" reason="Adjacent"/>
  <disable_collisions link1="left_tool0" link2="left_ctag_base_link" reason="Never"/>
  <disable_collisions link1="left_ctag_base_link" link2="left_ctag_left_1_link" reason="Adjacent"/>
  <disable_collisions link1="left_ctag_base_link" link2="left_ctag_left_2_link" reason="Adjacent"/>
  <disable_collisions link1="left_ctag_base_link" link2="left_ctag_right_1_link" reason="Adjacent"/>
  <disable_collisions link1="left_ctag_base_link" link2="left_ctag_right_2_link" reason="Adjacent"/>
  <disable_collisions link1="left_ctag_left_1_link" link2="left_ctag_left_support_link" reason="Adjacent"/>
  <disable_collisions link1="left_ctag_right_1_link" link2="left_ctag_right_support_link" reason="Adjacent"/>
  <disable_collisions link1="left_ctag_left_support_link" link2="left_ctag_left_2_link" reason="Never"/>
  <disable_collisions link1="left_ctag_right_support_link" link2="left_ctag_right_2_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_support_link" link2="left_ctag_right_support_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_support_link" link2="left_ctag_right_1_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_support_link" link2="left_ctag_right_2_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_1_link" link2="left_ctag_left_2_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_1_link" link2="left_ctag_right_1_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_1_link" link2="left_ctag_right_2_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_1_link" link2="left_ctag_right_support_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_2_link" link2="left_ctag_right_1_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_2_link" link2="left_ctag_right_2_link" reason="Never"/>
  <disable_collisions link1="left_ctag_left_2_link" link2="left_ctag_right_support_link" reason="Never"/>
  <disable_collisions link1="left_ctag_right_1_link" link2="left_ctag_right_2_link" reason="Never"/>

  <!-- Adjacent-link collision exclusions for the right arm. -->
  <disable_collisions link1="right_base_link" link2="right_link1" reason="Adjacent"/>
  <disable_collisions link1="right_link1" link2="right_link2" reason="Adjacent"/>
  <disable_collisions link1="right_link2" link2="right_link3" reason="Adjacent"/>
  <disable_collisions link1="right_link3" link2="right_link4" reason="Adjacent"/>
  <disable_collisions link1="right_link4" link2="right_link5" reason="Adjacent"/>
  <disable_collisions link1="right_link5" link2="right_link6" reason="Adjacent"/>
  <disable_collisions link1="right_link6" link2="right_link7" reason="Adjacent"/>
  <disable_collisions link1="right_link7" link2="right_tool0" reason="Adjacent"/>
  <disable_collisions link1="right_tool0" link2="right_tcp_link" reason="Adjacent"/>
  <disable_collisions link1="right_link7" link2="right_ctag_ft_sensor_link" reason="Adjacent"/>
  <disable_collisions link1="right_tool0" link2="right_ctag_ft_sensor_link" reason="Adjacent"/>
  <disable_collisions link1="right_ctag_ft_sensor_link" link2="right_ctag_connector_link" reason="Adjacent"/>
  <disable_collisions link1="right_ctag_connector_link" link2="right_ctag_base_link" reason="Adjacent"/>
  <disable_collisions link1="right_tool0" link2="right_ctag_connector_link" reason="Adjacent"/>
  <disable_collisions link1="right_tool0" link2="right_ctag_base_link" reason="Never"/>
  <disable_collisions link1="right_ctag_base_link" link2="right_ctag_left_1_link" reason="Adjacent"/>
  <disable_collisions link1="right_ctag_base_link" link2="right_ctag_left_2_link" reason="Adjacent"/>
  <disable_collisions link1="right_ctag_base_link" link2="right_ctag_right_1_link" reason="Adjacent"/>
  <disable_collisions link1="right_ctag_base_link" link2="right_ctag_right_2_link" reason="Adjacent"/>
  <disable_collisions link1="right_ctag_left_1_link" link2="right_ctag_left_support_link" reason="Adjacent"/>
  <disable_collisions link1="right_ctag_right_1_link" link2="right_ctag_right_support_link" reason="Adjacent"/>
  <disable_collisions link1="right_ctag_left_support_link" link2="right_ctag_left_2_link" reason="Never"/>
  <disable_collisions link1="right_ctag_right_support_link" link2="right_ctag_right_2_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_support_link" link2="right_ctag_right_support_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_support_link" link2="right_ctag_right_1_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_support_link" link2="right_ctag_right_2_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_1_link" link2="right_ctag_left_2_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_1_link" link2="right_ctag_right_1_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_1_link" link2="right_ctag_right_2_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_1_link" link2="right_ctag_right_support_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_2_link" link2="right_ctag_right_1_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_2_link" link2="right_ctag_right_2_link" reason="Never"/>
  <disable_collisions link1="right_ctag_left_2_link" link2="right_ctag_right_support_link" reason="Never"/>
  <disable_collisions link1="right_ctag_right_1_link" link2="right_ctag_right_2_link" reason="Never"/>

  <!-- Mount/table contact is intentional. -->
  <disable_collisions link1="table_slab" link2="left_base_link" reason="Adjacent"/>
  <disable_collisions link1="table_slab" link2="right_base_link" reason="Adjacent"/>
</robot>
